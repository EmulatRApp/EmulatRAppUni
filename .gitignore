# Guest media / virtual storage -- multi-GB disk images, never tracked
vStorage/

# Redundant archive of tools/Editors/ (the source tree itself IS tracked)
tools/Editors.zip

# Superseded journal drafts staged for removal
journals/_to_delete/

# RE / analysis workspaces
ghidra/
traces/
sysvar_dump.txt
rpcc_probe.txt
firmware/
/journals/DS20_Badge_IIC_Completion_Interrupt_topic.xml

# packaging output + bridge deletion-staging
redist/
_to_delete/
tools/_to_delete/
# local agent/editor config (but SHARE .claude/skills/ -- versioned like
# CLAUDE.md/memory.md so every machine gets them via git pull)
.claude/*
!.claude/skills/
tools/Editors/.claude/
