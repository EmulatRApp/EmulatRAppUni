*.bak
*.bak.*
*-bak
*.orig
*~
*.swp
*.swo

# OS junk ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Linux / FUSE mount cruft (Cowork sandbox) -----------------------------------
.fuse_hidden*

# Other tooling ---------------------------------------------------------------
.vscode/
.idea/
*.tmp
# Unix core dumps -- anchored + file-only so a source directory named core/
# (e.g. tools/Editors/PlatformEditor/core/) is NOT silently swallowed.
/core
core.[0-9]*

# macOS AppleDouble resource forks / Finder metadata
._*
.DS_Store

