{
  "policy_version": 1,
  "comment": "Data-driven field policy for EmulatR platform manifests (SPEC-PLATED-001 Section 6.4). Keyed by path (Section 6.2). Tiers reflect the T-00 evidence (T-00_read_vs_echo_evidence.md): PCI identity and BARs are editable inputs, not derived. Editing this file adds/retiers fields without recompiling (P-1). Unlisted keys fall through to passthrough (P-2).",
  "rules": [
    { "path": "$.manifest_version", "tier": "int", "readOnly": true },
    { "path": "$.platform", "tier": "openEnum", "values": ["DS10", "DS20", "DS25", "ES40", "ES45"] },
    { "path": "$.comment", "tier": "multiline" },

    { "path": "$.iic_devices[*].name", "tier": "openEnum" },
    { "path": "$.iic_devices[*].address", "tier": "hex" },
    { "path": "$.iic_devices[*].class", "tier": "enum", "values": ["status", "fru_eeprom", "nvram", "led"] },
    { "path": "$.iic_devices[*].byte", "tier": "hex" },
    { "path": "$.iic_devices[*].size", "tier": "int", "min": 1, "max": 65536 },
    { "path": "$.iic_devices[*].manufacturer", "tier": "openEnum", "values": ["DEC"] },
    { "path": "$.iic_devices[*].model", "tier": "openEnum" },
    { "path": "$.iic_devices[*].part_class", "tier": "free" },
    { "path": "$.iic_devices[*].serial", "tier": "free" },
    { "path": "$.iic_devices[*].revision_ro", "tier": "hex" },
    { "path": "$.iic_devices[*].revision_rw", "tier": "hex" },
    { "path": "$.iic_devices[*].comment", "tier": "multiline" },

    { "path": "$.pci_devices[*].name", "tier": "openEnum" },
    { "path": "$.pci_devices[*].model", "tier": "openEnum", "values": ["generic", "passive"] },
    { "path": "$.pci_devices[*].hose", "tier": "int", "min": 0, "max": 1 },
    { "path": "$.pci_devices[*].bus", "tier": "int", "min": 0, "max": 255 },
    { "path": "$.pci_devices[*].slot", "tier": "int", "min": 0, "max": 31 },
    { "path": "$.pci_devices[*].func", "tier": "int", "min": 0, "max": 7 },
    { "path": "$.pci_devices[*].vendor", "tier": "hex", "catalogDefault": "catalog:$.pci_devices[*].model#vendor" },
    { "path": "$.pci_devices[*].device", "tier": "hex", "catalogDefault": "catalog:$.pci_devices[*].model#device" },
    { "path": "$.pci_devices[*].class_code", "tier": "hex", "catalogDefault": "catalog:$.pci_devices[*].model#class_code" },
    { "path": "$.pci_devices[*].revision", "tier": "hex" },
    { "path": "$.pci_devices[*].subsys_vendor", "tier": "hex" },
    { "path": "$.pci_devices[*].subsys_id", "tier": "hex" },
    { "path": "$.pci_devices[*].option_rom", "tier": "bool" },
    { "path": "$.pci_devices[*].interrupt_pin", "tier": "int", "min": 0, "max": 4 },
    { "path": "$.pci_devices[*].comment", "tier": "multiline" },

    { "path": "$.pci_devices[*].bars[*].index", "tier": "int", "min": 0, "max": 5 },
    { "path": "$.pci_devices[*].bars[*].kind", "tier": "enum", "values": ["io", "mem"] },
    { "path": "$.pci_devices[*].bars[*].size", "tier": "hex" },
    { "path": "$.pci_devices[*].bars[*].prefetch", "tier": "bool" },

    { "path": "$.pci_devices[*].channels[*].index", "tier": "int", "min": 0, "max": 3, "note": "_PROVISIONAL SCSI bus index; FK target for storage[].channel (SPEC-SCSIH-001 Sec 4.2)" },
    { "path": "$.pci_devices[*].channels[*].initiator_id", "tier": "int", "min": 0, "max": 15, "note": "HBA's own SCSI target id; default 0x7" },
    { "path": "$.pci_devices[*].channels[*].width", "tier": "enum", "values": ["narrow", "wide"], "note": "narrow = 8-bit (target 0..7), wide = 16-bit (0..15)" },
    { "path": "$.pci_devices[*].channels[*].comment", "tier": "multiline" },

    { "path": "$.pci_devices[*].storage[*].label", "tier": "free", "note": "device moniker; display default = media basename minus extension, overrideable. Tool/display field; the emulator ignores it (P-2 preserves)." },
    { "path": "$.pci_devices[*].storage[*].channel", "tier": "int", "min": 0, "max": 3, "note": "IDE: primary/secondary (0..1). SCSI: FK -> channels[].index (SPEC-SCSIH-001 Sec 3.1)" },
    { "path": "$.pci_devices[*].storage[*].unit", "tier": "int", "min": 0, "max": 15, "note": "IDE master/slave (0..1); SCSI target id (0..7 narrow, 0..15 wide). Widened widget per SPEC-SCSIH-001 Sec 9; validators narrow it (V-25/V-27)" },
    { "path": "$.pci_devices[*].storage[*].lun", "tier": "int", "min": 0, "max": 7 },
    { "path": "$.pci_devices[*].storage[*].type", "tier": "enum", "values": ["ata_disk", "atapi_cdrom", "scsi_disk", "scsi_cdrom", "scsi_tape"], "note": "scsi_* are _PROVISIONAL (SPEC-SCSIH-001): v4 emulator storageTypeFromString accepts only ata_disk/atapi_cdrom; pending consumer + v5" },
    { "path": "$.pci_devices[*].storage[*].model", "tier": "openEnum" },
    { "path": "$.pci_devices[*].storage[*].media", "tier": "path" },
    { "path": "$.pci_devices[*].storage[*].media_kind", "tier": "enum", "values": ["image", "iso", "host"] },
    { "path": "$.pci_devices[*].storage[*].enabled", "tier": "bool" },
    { "path": "$.pci_devices[*].storage[*].create_if_missing", "tier": "bool" },
    { "path": "$.pci_devices[*].storage[*].size", "tier": "size", "min": 512 },
    { "path": "$.pci_devices[*].storage[*].comment", "tier": "multiline" }
  ],
  "containers": [
    { "path": "$", "labelFormat": "{platform}" },
    { "path": "$.iic_devices[*]", "labelFormat": "{name}  {address}  {class}" },
    { "path": "$.pci_devices[*]", "labelFormat": "{name}  {hose}:{bus}:{slot}.{func}  {vendor}:{device}" },
    { "path": "$.pci_devices[*].bars[*]", "labelFormat": "BAR{index}  {kind}  {size}" },
    { "path": "$.pci_devices[*].channels[*]", "labelFormat": "ch{index}  init={initiator_id}  {width}" },
    { "path": "$.pci_devices[*].storage[*]", "labelFormat": "ch{channel} unit{unit}  {type}" }
  ]
}
