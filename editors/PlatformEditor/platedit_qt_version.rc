// ============================================================================
// version.rc.in -- shared Windows VERSIONINFO template (2026-08-14)
// ============================================================================
// Configured per-target by CMake (configure_file @ONLY): the version numbers
// come from the owning project() VERSION, so the exe properties, the CMake
// version, and (for Emulatr) the H&M doc badge that sync_hm_version.py
// mirrors all share ONE source of truth.  APP_* variables are set by the
// target's CMakeLists immediately before configure_file.
// ============================================================================
#include <windows.h>

IDI_ICON1 ICON "D:/EmulatR/emulatrappuniv5/editors/PlatformEditor/resources/PlatEdit.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "eNVy Systems, Inc."
            VALUE "FileDescription",  "ASA EmulatR Platform Editor"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "platedit_qt.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 eNVy Systems, Inc.  All rights reserved."
            VALUE "OriginalFilename", "platedit_qt.exe"
            VALUE "ProductName",      "ASA EmulatR"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
