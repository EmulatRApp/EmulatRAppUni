// ============================================================================
//
// SINGLE SOURCE OF TRUTH: project(Emulatr VERSION <maj>.<min>.<build>) in the
// root CMakeLists.txt.  CMake configure_file() renders this template into
// <binary-dir>/generated/emulatr_version.h; NOTHING else defines the version.
//
// Version grammar (H&M topic "EmulatR Version Numbering and Release Stages"):
//   <stage><major>.<variant>-<build>, e.g. "X1.5-12"
//   STAGE = DEC release-stage letter: X experimental, T field test, V released
//   MAJOR = release series (1)       MINOR = emulatrappuni variant (5)
//   BUILD = deliberate build number  (EMULATR_VERSION_STAGE in CMakeLists.txt)
//
// The same three numbers are mirrored into the Help & Manual project
// (H&M/HMDocs/claudeRV4.hmxp config-values versionmajor/minor/build) by
// tools/sync_hm_version.py, invoked from tools/build_emulatr.sh.  To bump the
// version, edit the ONE project() line and rebuild -- do not edit this file's
// output, and do not hand-edit the H&M values.
// ============================================================================

#ifndef GENERATED_EMULATR_VERSION_H
#define GENERATED_EMULATR_VERSION_H

#define EMULATR_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define EMULATR_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define EMULATR_VERSION_BUILD  @PROJECT_VERSION_PATCH@
#define EMULATR_VERSION_STAGE  "@EMULATR_VERSION_STAGE@"

// DEC-style badge fragment: <stage><major>.<minor>-<build>  (e.g. "X1.5-12")
#define EMULATR_VERSION_STRING \
    "@EMULATR_VERSION_STAGE@@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@-@PROJECT_VERSION_PATCH@"

// Dotted form for packaging / logs (matches CPACK_PACKAGE_VERSION)
#define EMULATR_VERSION_DOTTED \
    "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"

#endif // GENERATED_EMULATR_VERSION_H
